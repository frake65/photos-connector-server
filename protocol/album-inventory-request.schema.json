{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "source", "albums"],
  "properties": {
    "version": {"const": 1},
    "source": {
      "type": "object",
      "required": ["sourceId", "name"],
      "properties": {
        "sourceId": {"type": "string", "format": "uuid"},
        "name": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "albums": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["localIdentifier", "name", "kind"],
        "properties": {
          "localIdentifier": {"type": "string", "minLength": 1},
          "cloudIdentifier": {"type": ["string", "null"]},
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["album", "folder"]},
          "parentLocalIdentifier": {"type": ["string", "null"]},
          "assets": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "assetIdentities": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
