{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Apple Photos Connector inventory response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "summary", "assets"],
  "properties": {
    "runId": {"type": "string", "format": "uuid"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seen", "new", "known"],
      "properties": {
        "seen": {"type": "integer", "minimum": 0},
        "new": {"type": "integer", "minimum": 0},
        "known": {"type": "integer", "minimum": 0}
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cloudIdentifier", "state", "upload"],
        "properties": {
          "cloudIdentifier": {"type": ["string", "null"]},
          "state": {"enum": ["new", "known"]},
          "upload": {
            "oneOf": [
              {"type": "null"},
              {"type": "object", "additionalProperties": false, "required": ["uploadId", "assetId"],
               "properties": {"uploadId": {"type": "string", "format": "uuid"}, "assetId": {"type": "string", "pattern": "^[1-9][0-9]*$"}}}
            ]
          }
        },
        "allOf": [{
          "if": {"properties": {"state": {"const": "known"}}},
          "then": {"properties": {"upload": {"type": "null"}}},
          "else": {"properties": {"upload": {"type": "object"}}}
        }]
      }
    }
  }
}
